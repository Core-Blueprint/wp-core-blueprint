#!/usr/bin/env python3
"""Build a deterministic Core Blueprint production ZIP.

The package boundary is allowlist-based so repository/test tooling can never
silently leak into a public plugin archive.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import posixpath
import struct
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

PLUGIN_ROOT = "core-blueprint"
ROOT_FILES = (
    "core-blueprint.php",
    "uninstall.php",
    "README.md",
    "readme.txt",
    "CHANGELOG.md",
    "LICENSE",
)
RUNTIME_DIRS = (
    "src",
    "includes",
    "assets",
    "templates",
    "languages",
    "licenses",
)
PACKAGE_EXCLUDED_FILES = frozenset({
    "src/PDF/lib/dompdf/autoload.inc.php",
})
FIXED_ZIP_TIME = (1980, 1, 1, 0, 0, 0)
DESIGN_MODULE_ROOT = Path("assets/js/design")
DESIGN_IMPORT_RE = re.compile(
    r"(?P<prefix>\b(?:from|import)\s+)(?P<quote>['\"])(?P<specifier>\.{1,2}/[^'\"?]+\.js)(?P=quote)"
)
DESIGN_RELATIVE_JS_RE = re.compile(
    r"(?P<quote>['\"])(?P<specifier>\.{1,2}/[^'\"?]+\.js)(?P=quote)"
)


def fail(message: str) -> "NoReturn":
    print(f"[release] ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_version(plugin_file: Path) -> str:
    text = plugin_file.read_text(encoding="utf-8")
    header = re.search(r"^\s*\*\s*Version:\s*([^\s]+)\s*$", text, re.MULTILINE)
    constant = re.search(r"define\(\s*'CB_CORE_VERSION'\s*,\s*'([^']+)'\s*\);", text)
    if not header or not constant:
        fail("Could not resolve both plugin header Version and CB_CORE_VERSION.")
    if header.group(1) != constant.group(1):
        fail(
            "Version mismatch: plugin header "
            f"{header.group(1)!r} != CB_CORE_VERSION {constant.group(1)!r}."
        )
    return header.group(1)


def collect_files(source: Path) -> list[Path]:
    files: list[Path] = []

    for relative in ROOT_FILES:
        path = source / relative
        if not path.is_file():
            fail(f"Required release file is missing: {relative}")
        if path.is_symlink():
            fail(f"Release file may not be a symlink: {relative}")
        files.append(path)

    for relative in RUNTIME_DIRS:
        root = source / relative
        if not root.is_dir():
            fail(f"Required runtime directory is missing: {relative}/")
        if root.is_symlink():
            fail(f"Runtime directory may not be a symlink: {relative}/")
        for path in sorted(root.rglob("*")):
            if path.is_symlink():
                fail(f"Release tree may not contain symlinks: {path.relative_to(source)}")
            if path.is_file():
                relative_path = path.relative_to(source).as_posix()
                if relative_path in PACKAGE_EXCLUDED_FILES:
                    continue
                files.append(path)

    if not files:
        fail("Release allowlist resolved to zero files.")

    return sorted(files, key=lambda item: item.relative_to(source).as_posix())


def run_gate(command: list[str], source: Path, label: str, quiet: bool = False) -> None:
    print(f"[release] gate: {label}", flush=True)
    result = subprocess.run(command, cwd=source, capture_output=quiet, text=True)
    if result.returncode:
        if quiet:
            print(result.stdout or "", end="")
            print(result.stderr or "", end="", file=sys.stderr)
        fail(f"{label} failed (exit {result.returncode}).")


def runtime_hashes(source: Path) -> dict[str, str]:
    return {
        path.relative_to(source).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
        for path in collect_files(source)
    }


def design_module_revision(source: Path) -> str:
    root = source / DESIGN_MODULE_ROOT
    modules = sorted(
        root.rglob("*.js"),
        key=lambda item: item.relative_to(source).as_posix(),
    )
    if not modules:
        fail("Design Foundation module graph is missing.")

    digest = hashlib.sha256()
    for path in modules:
        digest.update(path.relative_to(source).as_posix().encode("utf-8"))
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()[:16]


def package_bytes(source: Path, path: Path, design_revision: str | None = None) -> bytes:
    payload = path.read_bytes()
    relative = path.relative_to(source)
    if (
        design_revision
        and relative.suffix == ".js"
        and DESIGN_MODULE_ROOT in relative.parents
    ):
        text = payload.decode("utf-8")

        def stamp(match: re.Match[str]) -> str:
            return (
                f"{match.group('prefix')}{match.group('quote')}"
                f"{match.group('specifier')}?cb-design={design_revision}"
                f"{match.group('quote')}"
            )

        stamped = DESIGN_IMPORT_RE.sub(stamp, text)
        leftover = DESIGN_RELATIVE_JS_RE.search(stamped)
        if leftover:
            fail(
                "Unversioned relative Design module reference remains in "
                f"{relative.as_posix()}: {leftover.group('specifier')}"
            )
        payload = stamped.encode("utf-8")
    return payload


def package_hashes(source: Path, files: list[Path], design_revision: str) -> dict[str, str]:
    return {
        path.relative_to(source).as_posix(): hashlib.sha256(
            package_bytes(source, path, design_revision)
        ).hexdigest()
        for path in files
    }


# The single Base packaging algorithm shared by development and release.
# Only source-approved bytes are inputs. The manifest is generated from FINAL
# transformed assets and is deliberately not included in its own file map.
PLATFORM_STAMP_FILE = "assets/js/design/editor.js"
PLATFORM_WITNESS_FILE = "assets/css/design/editor-shell.css"
PLATFORM_MANIFEST = "artifact-manifest.json"
PLATFORM_WITNESS_SELECTOR = "[data-cb-artifact-base-designer-shell]"
PLATFORM_REQUIRED = (
    "src/Design/Integrity/ArtifactManifest.php",
    "assets/js/design/platform/host.js",
    PLATFORM_STAMP_FILE,
    PLATFORM_WITNESS_FILE,
)
PLATFORM_IMPORT_RE = re.compile(
    r"\b(?:from|import)\s+['\"](?P<path>\.{1,2}/[^'\"]+\.js)(?:\?cb-design=[a-f0-9]+)?['\"]"
)


def _length_prefix(value: str) -> bytes:
    encoded = value.encode("utf-8")
    return struct.pack(">I", len(encoded)) + encoded


def _canonical_json(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def _platform_source_sha(source: Path) -> str:
    result = subprocess.run(["git", "rev-parse", "HEAD"], cwd=source, capture_output=True, text=True)
    sha = result.stdout.strip()
    if result.returncode or not re.fullmatch(r"[a-f0-9]{40}", sha):
        fail("Designer manifest requires an exact committed source SHA.")
    return sha


def package_payloads(source: Path, files: list[Path], revision: str) -> dict[str, bytes]:
    """Immutable final bytes for ZIP verification; no DDL, install or runtime fetch."""
    payloads = {
        path.relative_to(source).as_posix(): package_bytes(source, path, revision)
        for path in files
    }
    present = [path in payloads for path in PLATFORM_REQUIRED]
    if not any(present):
        return payloads  # Small independent builder fixtures remain unchanged.
    if not all(present):
        fail("Incomplete Designer Platform source inventory; refusing partial artifact.")
    if PLATFORM_MANIFEST in payloads:
        fail("Artifact manifest must be generated, never loaded from source.")

    source_sha = _platform_source_sha(source)
    stamp = "base-a2-" + revision
    stamps: dict[str, str] = {}
    for path in sorted(payloads):
        if path.startswith("assets/js/design/") and path.endswith(".js"):
            payload = payloads[path]
            if b"__cbPlatformModuleStamp" in payload:
                fail("Source must not mint its own package module stamp: " + path)
            if re.search(rb"\bimport\s*\(", payload):
                fail("Designer profile imports must remain static: " + path)
            payloads[path] = payload + (
                "\nexport const __cbPlatformModuleStamp = " + json.dumps(stamp) + ";\n"
            ).encode("utf-8")
            stamps[path] = stamp

    path = PLATFORM_WITNESS_FILE
    css = payloads[path]
    witness = hashlib.sha256(
        _length_prefix("cb-css-witness-v1")
        + _length_prefix("core-blueprint/base")
        + _length_prefix(revision)
        + _length_prefix(path)
        + _length_prefix(hashlib.sha256(css).hexdigest())
    ).hexdigest()
    rule = PLATFORM_WITNESS_SELECTOR + "{--cb-artifact-witness:" + witness + ";}"
    if rule.encode("ascii") in css or b"--cb-artifact-witness" in css:
        fail("Designer shell witness already exists in source CSS.")
    payloads[path] = css + b"\n" + rule.encode("ascii") + b"\n"

    files_sha = {
        path: hashlib.sha256(payload).hexdigest()
        for path, payload in sorted(payloads.items())
    }
    graph: dict[str, list[str]] = {}
    for path, data in sorted(payloads.items()):
        if not path.startswith("assets/js/design/") or not path.endswith(".js"):
            continue
        text = data.decode("utf-8")
        imports = set()
        for match in PLATFORM_IMPORT_RE.finditer(text):
            dependency = posixpath.normpath(posixpath.join(posixpath.dirname(path), match.group("path")))
            if dependency not in files_sha or not dependency.endswith(".js"):
                fail("Packaged static ESM dependency missing: " + dependency)
            imports.add(dependency)
        graph[path] = sorted(imports)

    build_input = b"".join(
        _length_prefix(path) + _length_prefix(digest)
        for path, digest in sorted(files_sha.items())
    )
    manifest = {
        "contractVersion": 1,
        "buildId": hashlib.sha256(build_input).hexdigest(),
        "packageIdentity": {
            "packageId": "core-blueprint/base",
            "sourceSha": source_sha,
            "buildGeneration": revision,
            "capabilities": [],
            "moduleStamps": stamps,
        },
        "files": files_sha,
        "moduleGraph": graph,
        "requiredCss": [{
            "assetId": "base-designer-shell",
            "path": path,
            "approvedCssWitness": witness,
            "selector": PLATFORM_WITNESS_SELECTOR,
            "packagedDigest": files_sha[path],
        }],
        "exclusions": {
            "manifest": PLATFORM_MANIFEST,
            "zipDigest": "external-only",
            "manifestDigest": "external-only",
        },
    }
    payloads[PLATFORM_MANIFEST] = _canonical_json(manifest)
    return payloads


def add_packaged_bytes(archive: zipfile.ZipFile, relative: str, payload: bytes) -> None:
    """The existing deterministic ZIP metadata, now for generated files too."""
    info = zipfile.ZipInfo(f"{PLUGIN_ROOT}/{relative}", FIXED_ZIP_TIME)
    info.compress_type = zipfile.ZIP_DEFLATED
    info.create_system = 3
    info.external_attr = 0o100644 << 16
    archive.writestr(info, payload, compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)


def preflight(source: Path, expected: dict[str, str]) -> None:
    for tool in ("php", "node", "bash", "unzip", "composer"):
        if shutil.which(tool) is None:
            fail(f"Required tool is missing: {tool}.")
    for relative in (
        "tools/check", "tools/check-translations.php", "tests/bin/php-lint.sh",
        "tests/bin/run-release-package-scenario.sh", "vendor/bin/phpunit",
        "vendor/autoload.php", "phpunit.xml.dist", "tests/python/test_build_release.py",
    ):
        if not (source / relative).is_file():
            fail(f"Required release gate/dependency is missing: {relative}.")

    # Require explicit test configuration; never silently select a database.
    for key in ("WP_CORE_DIR", "WP_TESTS_DIR", "CB_PLUGIN_FILE", "WP_DB_NAME",
                "WP_DB_USER", "WP_DB_PASSWORD", "WP_DB_HOST"):
        if not os.environ.get(key):
            fail(f"{key} is required for the isolated WordPress integration gate.")
    for path in (Path(os.environ["WP_CORE_DIR"]) / "wp-load.php",
                 Path(os.environ["WP_TESTS_DIR"]) / "includes/bootstrap.php"):
        if not path.is_file():
            fail(f"WordPress test environment is incomplete: {path}.")
    plugin = Path(os.environ["CB_PLUGIN_FILE"]).resolve()
    if plugin.name != "core-blueprint.php" or plugin.parent.name != PLUGIN_ROOT:
        fail("CB_PLUGIN_FILE must identify the canonical core-blueprint/core-blueprint.php test copy.")
    if not plugin.is_file() or runtime_hashes(plugin.parent) != expected:
        fail("WordPress test copy differs from release source; refresh it before building.")

    run_gate([
        "php", "-r",
        'if (PHP_VERSION_ID < 80400) { fwrite(STDERR, "PHP 8.4+ required.\\n"); exit(1); } '
        'foreach (["dom", "xml", "xmlwriter", "mbstring", "mysqli", "gd", "sodium"] as $extension) '
        '{ if (!extension_loaded($extension)) { fwrite(STDERR, "Missing PHP extension: " . $extension . "\\n"); exit(1); } }',
    ], source, "PHP baseline and integration extensions")
    # The source-only Level 1 gate is canonical and must pass before
    # the builder's existing independent release/WordPress gates.
    run_gate(["bash", "tools/check"], source, "Canonical Base Level 1", quiet=True)
    run_gate([sys.executable, "-m", "unittest", "discover", "-s", "tests/python"],
             source, "Release builder failure paths", quiet=True)
    run_gate(["bash", "tests/bin/php-lint.sh"], source, "PHP syntax and read-only localization")
    scripts = sorted(source.joinpath("assets").rglob("*.js"))
    for path in scripts:
        result = subprocess.run(["node", "--check", str(path)], capture_output=True, text=True)
        if result.returncode:
            print(result.stderr, file=sys.stderr)
            fail(f"JavaScript syntax failed: {path.relative_to(source)}.")
    print(f"[release] JavaScript syntax PASS: {len(scripts)} files", flush=True)
    tests = sorted(source.joinpath("tests/js").glob("*.test.mjs"))
    if not tests:
        fail("JavaScript regression suite is missing.")
    run_gate(["node", "--test", *map(str, tests)], source, "JavaScript regressions", quiet=True)
    run_gate(["php", "vendor/bin/phpunit", "--testsuite", "integration",
              "--do-not-cache-result", "--fail-on-skipped", "--fail-on-incomplete"],
             source, "WordPress integration")
    if runtime_hashes(source) != expected or runtime_hashes(plugin.parent) != expected:
        fail("Release source or WordPress test copy changed during validation.")


def verify_archive(path: Path, expected: dict[str, str]) -> None:
    with zipfile.ZipFile(path) as archive:
        names = archive.namelist()
        required = {f"{PLUGIN_ROOT}/{relative}" for relative in expected}
        if len(names) != len(required) or set(names) != required:
            fail("Archive entries differ from the verified runtime manifest.")
        if archive.testzip() is not None:
            fail("ZIP integrity verification failed.")
        for relative, digest in expected.items():
            if hashlib.sha256(archive.read(f"{PLUGIN_ROOT}/{relative}")).hexdigest() != digest:
                fail(f"Archive bytes differ from verified source: {relative}.")


def add_file(
    archive: zipfile.ZipFile,
    source: Path,
    path: Path,
    design_revision: str | None = None,
) -> None:
    relative = path.relative_to(source).as_posix()
    add_packaged_bytes(archive, relative, package_bytes(source, path, design_revision))


def build(source: Path, output_dir: Path) -> tuple[Path, Path]:
    source = source.resolve()
    output_dir = output_dir.resolve()

    for directory in RUNTIME_DIRS:
        if output_dir == source / directory or source.joinpath(directory) in output_dir.parents:
            fail("Output directory must be outside packaged runtime directories.")

    plugin_file = source / "core-blueprint.php"
    version = read_version(plugin_file)
    files = collect_files(source)

    # Proven-environment binding is optional for source-only failure-path
    # fixtures, which deliberately lack the real integration runner. Real
    # Base sources include this file and must pass its safety gates.
    if (source / "tools/integration/release_env.py").is_file():
        sys.path.insert(0, str(source))
        from tools.integration import release_env
        try:
            release_env.bind(source)
        except Exception as error:
            fail("Proven Level 2 environment unavailable: " + str(error))

    source_expected = runtime_hashes(source)
    preflight(source, source_expected)
    design_revision = design_module_revision(source)
    payloads = package_payloads(source, files, design_revision)
    package_expected = {path: hashlib.sha256(data).hexdigest() for path, data in payloads.items()}

    # Only verified archives receive the final release name/checksum. On gate
    # failure an earlier accepted artifact is preserved, never overwritten.
    output_dir.mkdir(parents=True, exist_ok=True)
    zip_path = output_dir / f"core-blueprint-{version}.zip"
    checksum_path = output_dir / f"core-blueprint-{version}.zip.sha256"
    with tempfile.TemporaryDirectory(prefix=".cb-release-", dir=output_dir) as temporary:
        pending_zip = Path(temporary) / zip_path.name
        pending_checksum = Path(temporary) / checksum_path.name
        with zipfile.ZipFile(pending_zip, "w") as archive:
            for relative, payload in sorted(payloads.items()):
                add_packaged_bytes(archive, relative, payload)
        verify_archive(pending_zip, package_expected)
        run_gate(["bash", "tests/bin/run-release-package-scenario.sh",
                  str(pending_zip), version], source, "Packaged runtime boundary and PHP syntax")
        # Recheck after the package gate and before publishing its checksum.
        verify_archive(pending_zip, package_expected)
        if runtime_hashes(source) != source_expected:
            fail("Release source changed during packaging.")
        digest = hashlib.sha256(pending_zip.read_bytes()).hexdigest()
        pending_checksum.write_text(f"{digest}  {zip_path.name}\n", encoding="utf-8")
        os.replace(pending_zip, zip_path)
        os.replace(pending_checksum, checksum_path)

    print(f"[release] version: {version}")
    print(f"[release] files: {len(files)}")
    print(f"[release] zip: {zip_path}")
    print(f"[release] sha256: {digest}")
    return zip_path, checksum_path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    default_source = Path(__file__).resolve().parents[1]
    parser.add_argument(
        "--source",
        type=Path,
        default=default_source,
        help="Repository/source root to package (default: repository containing this tool).",
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=default_source / "dist",
        help="Directory for ZIP and SHA-256 output (default: <source>/dist).",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not args.source.is_dir():
        fail(f"Source directory does not exist: {args.source}")
    build(args.source, args.output_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
